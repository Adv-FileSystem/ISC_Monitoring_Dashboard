[Unit]
Description=FPGA Monitoring Dashboard
After=network.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/fpga-dashboard/backend
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8811
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
